# Copier ce fichier vers .env puis remplacer les valeurs.
# Ne jamais committer le fichier .env (il est dans .gitignore).

# Neon — connexion POOLÉE (hostname contenant -pooler), utilisée par l'application
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon — connexion DIRECTE (sans -pooler), utilisée par les commandes Prisma
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# NextAuth — à générer avec : openssl rand -base64 32
NEXTAUTH_SECRET="remplacez-par-une-chaine-aleatoire-longue"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optionnel mais recommandé en production)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
